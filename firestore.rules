rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /submissions/{id} {
      // visitors only see approved items; admin sees everything
      allow read: if resource.data.status == 'approved'
                  || (request.auth != null && request.auth.token.email == 'heyitsaymenbabe@gmail.com');
      // visitors can only create PENDING items, with the server date
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.type in ['memory', 'quote']
                    && !('featuredYear' in request.resource.data)
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 30
                    && request.resource.data.createdAt == request.time
                    && (request.resource.data.type == 'quote'
                        ? (request.resource.data.text is string && request.resource.data.text.size() <= 300)
                        : (request.resource.data.image is string && request.resource.data.image.size() < 900000));
      allow update, delete: if request.auth != null && request.auth.token.email == 'heyitsaymenbabe@gmail.com';
    }
  }
}
